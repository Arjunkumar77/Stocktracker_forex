<?xml version="1.0" encoding="utf-8"?>
<!--
  Android blocks plain "http://" traffic by default. Our dev API runs on
  plain http (not https), so this file explicitly allows cleartext
  traffic to the addresses the dev server can be reached at.

  Where this goes: after you run `flutter create .`, copy this file to
  android/app/src/main/res/xml/network_security_config.xml (create the
  xml folder if it doesn't exist), then follow the AndroidManifest.xml
  instructions in the main README.

  This is fine for local development. Before shipping a real app, point
  the Flutter app at an https:// API instead and remove this file.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <!-- If testing on a physical phone, add your computer's LAN IP too, e.g.: -->
        <!-- <domain includeSubdomains="false">192.168.1.42</domain> -->
    </domain-config>
</network-security-config>
